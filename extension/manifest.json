{
  "manifest_version": 3,
  "name": "Vibe Sentinel",
  "version": "1.9.0",
  "description": "Watches AI chat tabs in background, knows when generation stops, pings, grabs clean code and delivers it into VibeBridge.",
   "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://chat.qwen.ai/*", "https://qwen.ai/*", "https://chat.deepseek.com/*", "https://grok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://sleepop77-jpg.github.io/Vibebridge-web-version/*"],
      "js": ["bridgehook.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Vibe Sentinel" }
}